# Copie este arquivo para .env.local e preencha com os dados do seu
# projeto Supabase (Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Usada só em server actions/rotas administrativas (criar usuário, etc.).
# NUNCA exponha esta chave no cliente. Fica só no servidor (Vercel env var).
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role
